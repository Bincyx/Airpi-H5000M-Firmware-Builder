#!/bin/sh

# Configure Traditional Chinese LuCI and the Taipei timezone on first boot.
uci -q set luci.main.lang='zh_tw'
uci -q set luci.main.mediaurlbase='/luci-static/argon'
uci -q set system.@system[0].hostname='AirPi-H5000M'
uci -q set system.@system[0].zonename='Asia/Taipei'
uci -q set system.@system[0].timezone='CST-8'

# Set custom LAN IP
uci -q set network.lan.ipaddr='192.168.1.1'
uci -q commit network

# Apply the requested US wireless regulatory domain to existing radios.
for radio in radio0 radio1; do
	if uci -q get "wireless.${radio}" >/dev/null; then
		uci -q set "wireless.${radio}.country=US"
	fi
done

# Match the requested dark Argon layout with a teal accent safely.
uci -q batch <<EOF
	delete argon
	set argon.global=global
	set argon.global.mode='dark'
	set argon.global.primary='#0F766E'
	set argon.global.main_primary='#0F766E'
	set argon.global.dark_primary='#0F766E'
	set argon.global.blur='10'
	set argon.global.blur_dark='10'
	set argon.global.transparency='0.5'
	set argon.global.transparency_dark='0.5'
	commit argon
EOF

uci -q commit luci
uci -q commit system
uci -q commit wireless

# Keep AdGuard Home installed but disabled until the user configures DNS.
if [ -x /etc/init.d/adguardhome ]; then
	/etc/init.d/adguardhome disable
	/etc/init.d/adguardhome stop
fi

exit 0

